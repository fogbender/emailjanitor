{ config, lib, pkgs, ... }:
let
  cfg = config.services.emailjanitor-google-token;
  allowed = [ "type" "audience" "subject_token_type" "token_url"
    "service_account_impersonation_url" "service_account_impersonation"
    "credential_source" "universe_domain" "token_info_url" ];
  metadata = pkgs.writeText "emailjanitor-google-external-account.json"
    (builtins.toJSON cfg.configuration);
in {
  options.services.emailjanitor-google-token = {
    enable = lib.mkEnableOption "root-owned Google workload identity token refresh";
    package = lib.mkOption {
      type = lib.types.package;
      description = "Pinned official-SDK bridge providing bin/emailjanitor-google-token.";
    };
    configuration = lib.mkOption {
      type = lib.types.attrsOf lib.types.anything;
      description = "Non-secret external_account metadata generated by OpenTofu. Never client secrets, service-account keys or access tokens. The SDK bridge validates exact URLs and schema before contacting metadata services.";
    };
    group = lib.mkOption {
      type = lib.types.strMatching "[a-z_][a-z0-9_-]*";
      default = "emailjanitor";
      description = "Application group permitted to read the short-lived token file.";
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [{
      assertion = (cfg.configuration.type or null) == "external_account"
        && builtins.all (name: builtins.elem name allowed) (builtins.attrNames cfg.configuration);
      message = "The Google token helper accepts external-account metadata only, never client credentials.";
    }];
    users.groups.${cfg.group} = {};
    systemd.services.emailjanitor-google-token = {
      description = "Refresh short-lived Janitor Google Pub/Sub identity";
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];
      serviceConfig = {
        Type = "oneshot";
        User = "root";
        Group = cfg.group;
        ExecStart = "${cfg.package}/bin/emailjanitor-google-token --config ${metadata} --output /run/emailjanitor-google-token/token.json";
        RuntimeDirectory = "emailjanitor-google-token";
        RuntimeDirectoryMode = "0750";
        RuntimeDirectoryPreserve = "yes";
        UMask = "0027";
        TimeoutStartSec = 50;
        LimitCORE = 0;
        NoNewPrivileges = true;
        CapabilityBoundingSet = "";
        ProtectSystem = "strict";
        ProtectHome = true;
        PrivateTmp = true;
        PrivateDevices = true;
        ProtectProc = "invisible";
        ProcSubset = "pid";
        ProtectKernelTunables = true;
        ProtectKernelModules = true;
        ProtectKernelLogs = true;
        ProtectControlGroups = true;
        RestrictSUIDSGID = true;
        RestrictAddressFamilies = [ "AF_UNIX" "AF_INET" "AF_INET6" ];
        InaccessiblePaths = [ "-/run/secrets" "-/run/secrets.d" "-/run/credentials"
          "-/run/emailjanitor" "-/var/lib" "-/etc/ssh" ];
      };
    };
    systemd.timers.emailjanitor-google-token = {
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnBootSec = "5s";
        OnUnitActiveSec = "60s";
        AccuracySec = "1s";
      };
    };
  };
}
